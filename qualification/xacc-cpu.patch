+// Marqov compatibility addition: anti-controlled Z, 2026-09-09.
+class ACZ : public Gate {
+public:
+  ACZ() : Gate("ACZ") {}
+  ACZ(std::vector<std::size_t> bits) : Gate("ACZ", bits) {}
+  ACZ(std::size_t control, std::size_t target)
+      : ACZ(std::vector<std::size_t>{control, target}) {}
+  ACZ(std::vector<std::size_t> bits, std::vector<InstructionParameter> params)
+      : Gate("ACZ", bits, params) {}
+  const int nRequiredBits() const override { return 2; }
+  DEFINE_CLONE(ACZ)
+  DEFINE_VISITABLE()
+};
